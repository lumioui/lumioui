{
  "name": "@lumioui/core",
  "version": "0.1.0",
  "description": "LumioUI design tokens, theme engine, and shared utilities for React Native",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/tsup.mjs src/index.ts src/*/index.ts --format esm,cjs --dts --clean --external react --external react-native --external react-native-reanimated --external react-native-css-interop --external expo-haptics --external nativewind",
    "dev": "node ../../scripts/tsup.mjs src/index.ts src/*/index.ts --format esm,cjs --dts --watch --external react --external react-native --external react-native-reanimated --external react-native-css-interop --external expo-haptics --external nativewind",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0"
  },
  "peerDependencies": {
    "expo-constants": "*",
    "expo-haptics": "*",
    "nativewind": ">=4.0",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-reanimated": ">=3.0",
    "react-native-safe-area-context": ">=4.0",
    "react-native-svg": ">=15.0"
  },
  "peerDependenciesMeta": {
    "expo-constants": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-haptics": "~15.0.8",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumioui/lumioui.git",
    "directory": "packages/core"
  }
}
